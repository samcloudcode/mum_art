# Supabase PostgreSQL Database Configuration
# Get connection string from: Supabase Dashboard > Connect

# Direct connection (port 5432). Full session support, so anything holding a
# transaction open across statements behaves normally. This is what the working
# setup uses.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternative: transaction pooler on the same host (port 6543). Also works. Use
# it if you hit connection limits, but it does not keep session state between
# statements, so prepared statements and session-scoped SET can misbehave.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres

# Alternative: session pooler on a separate host (if IPv4 add-on not enabled)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Next.js frontend (normally placed in web/.env.local for local development)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]

# Inventory proposal agent. This key is server-only: never prefix it NEXT_PUBLIC.
ANTHROPIC_API_KEY=[YOUR-ANTHROPIC-API-KEY]
# Voice transcription. This key is also server-only.
OPENAI_API_KEY=[YOUR-OPENAI-API-KEY]
# Optional overrides; these are the application defaults.
ANTHROPIC_MODEL=claude-sonnet-5
ASSISTANT_TIME_ZONE=Europe/London
